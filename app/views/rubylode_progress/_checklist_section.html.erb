<%# A version section is a drop target only when the checklist is grouped by version and the version accepts issues;
    a version section that does not carries the reason, which the script shows on a drop. %>
<% versioned = grouping == "version" && section.version %>
<% drop_target = versioned && progress.accepts_issues?(section.version) %>
<% refuse_reason = versioned && !drop_target ? rubylode_progress_refuse_reason(section.version, can_manage: progress.can_manage_version?(section.version)) : nil %>
<% open_params = section.folded ? rubylode_progress_checklist_params(filter: filter, grouping: grouping, default_grouping: default_grouping, narrowing: narrowing, open: section.key) : nil %>
<%# A folded section keeps its heading and its drop target but lists no rows; the script loads them when it is opened. %>
<details class="rubylode-progress-section" <%= "open" unless section.folded %> data-section-key="<%= section.key %>" <%= tag.attributes(data: { lazy_section_path: url_for(controller: "rubylode_progress", action: "checklist", id: project, only_path: true, **open_params) }) if open_params %> <%= tag.attributes(data: { version_id: section.version.id }) if drop_target %> <%= tag.attributes(data: { refuse_reason: refuse_reason }) if refuse_reason %>>
  <summary class="rubylode-progress-section__summary">
    <span class="rubylode-progress-chevron" aria-hidden="true"></span>
    <h3 class="rubylode-progress-section__title">
      <%= section.title || l("rubylode_progress.other_section") %>
      <%# Under Open the count is the rows listed below it; the meter keeps the whole section for context. %>
      <span class="rubylode-progress-section__tally"><%= filter == "open" ? l("rubylode_progress.checklist.section_open", count: section.row_count) : l("rubylode_progress.checklist.section_tally", done: section.total_done_count, total: section.total_count) %></span>
    </h3>
    <%= render "meter", percent: section.percent %>
  </summary>
  <% if section.folded %>
    <%# Without a script the link reloads the page with this section open; the script swaps the section in when it is opened. %>
    <p class="rubylode-progress-section__lazy">
      <%= link_to l("rubylode_progress.show_stage_issues", count: section.row_count), project_rubylode_progress_path(project, **open_params),
                  class: "rubylode-progress-section__lazy-link" %>
    </p>
  <% else %>
    <ul class="rubylode-progress-rows">
      <% section.items.each do |item| %>
        <%= render "checklist_row", item: item, note: item_notes[item.issue.id],
                                     project: project, editable_issue_ids: progress.editable_issue_ids, filter: filter, grouping: grouping,
                                     settings: progress.settings, today: today %>
      <% end %>
    </ul>
  <% end %>
  <% if section.hidden_count.positive? %>
    <% more_params = rubylode_progress_checklist_params(filter: filter, grouping: grouping, default_grouping: default_grouping, narrowing: narrowing, expand: section.key) %>
    <p class="rubylode-progress-section__more">
      <%# Without a script this is an ordinary link that reloads the page with this one section listed in full. %>
      <%= link_to l("rubylode_progress.checklist.show_more", count: section.hidden_count), project_rubylode_progress_path(project, **more_params),
                  class: "rubylode-progress-show-more",
                  data: { checklist_path: url_for(controller: "rubylode_progress", action: "checklist", id: project, only_path: true, **more_params),
                          action: "click->rubylode-progress-filters#expand" } %>
    </p>
  <% end %>
</details>
