<% content_for :header_tags do %>
  <%= stylesheet_link_tag "rubylode_progress", plugin: "redmine_rubylode_progress" %>
  <%= javascript_include_tag "progress_filters", plugin: "redmine_rubylode_progress", type: "module" %>
<% end %>

<div class="rubylode-progress">
  <%= render "title", project: @project, last_change_on: @progress.last_change_on %>

  <% if @progress.stages.empty? %>
    <p class="rubylode-progress-empty"><%= l("rubylode_progress.nothing_to_track") %></p>
  <% else %>
    <%= render "tracker_panel", progress: @progress, today: @today %>
    <div class="rubylode-progress-columns">
      <%= render "stage_list", progress: @progress, project: @project %>
      <div class="rubylode-progress-checklist-column" data-controller="rubylode-progress-filters">
        <div data-rubylode-progress-filters-target="checklist">
          <%= render partial: "checklist", locals: checklist_locals %>
        </div>
      </div>
    </div>
  <% end %>
</div>
