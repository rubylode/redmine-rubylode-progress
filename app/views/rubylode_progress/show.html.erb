<% content_for :header_tags do %>
  <%= stylesheet_link_tag "rubylode_progress", plugin: "redmine_rubylode_progress" %>
  <%= javascript_include_tag "progress_filters", plugin: "redmine_rubylode_progress", type: "module" %>
  <%= javascript_include_tag "progress_move", plugin: "redmine_rubylode_progress", type: "module" %>
<% end %>

<div class="rubylode-progress" data-controller="rubylode-progress-fold">
  <%= render "title", project: @project %>

  <% if @progress.stages.empty? %>
    <p class="rubylode-progress-empty"><%= l("rubylode_progress.nothing_to_track") %></p>
  <% else %>
    <%# The rail's and the show all link's parameters are the page's own checked ones: the grouping the address asked for, not the
        flat one a focused page lists in, so leaving the focus brings it back. %>
    <% tracker_link_parameters = rubylode_progress_checklist_params(filter: @filter, grouping: @checked_grouping, default_grouping: @progress.settings.checklist_grouping, narrowing: @narrowing) %>
    <%= render "tracker_panel", progress: @progress, project: @project, today: @today, last_change_on: @progress.last_change_on,
                               focused_stage: @progress.focused_stage, link_parameters: tracker_link_parameters %>
    <%# One controller for both columns: the stage list and the checklist rows are dragged between the drop targets. The
        messages are server-rendered text; the address of each move is on the dragged row. %>
    <div class="rubylode-progress-columns" data-controller="rubylode-progress-move"
         data-rubylode-progress-move-refused-message-value="<%= l("rubylode_progress.move.refused") %>"
         data-rubylode-progress-move-failed-message-value="<%= l("rubylode_progress.move.failed") %>"
         data-action="dragstart->rubylode-progress-move#start dragend->rubylode-progress-move#finish dragenter->rubylode-progress-move#over dragover->rubylode-progress-move#over dragleave->rubylode-progress-move#leave drop->rubylode-progress-move#drop">
      <%= render "stage_list", progress: @progress, project: @project, open_stage_id: @open_stage_id %>
      <div class="rubylode-progress-checklist-column" data-controller="rubylode-progress-filters">
        <p class="rubylode-progress-move-message" role="status" aria-live="polite" hidden data-rubylode-progress-move-target="message"></p>
        <div data-rubylode-progress-filters-target="checklist">
          <%= render partial: "checklist", locals: checklist_locals %>
        </div>
      </div>
    </div>
  <% end %>
</div>
