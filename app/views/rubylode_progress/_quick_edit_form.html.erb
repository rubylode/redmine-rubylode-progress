<h3 class="title"><%= l("rubylode_progress.quick_edit.title", number: issue.id, subject: issue.subject) %></h3>

<%= form_tag issue_path(issue), method: :patch, class: "rubylode-progress-form" do %>
  <%= hidden_field_tag :back_url, back_url %>
  <div class="box tabular">
    <% if issue.safe_attribute?("status_id") %>
      <p>
        <%= label_tag "rubylode_progress_issue_status_id", l(:field_status) %>
        <%= select_tag "issue[status_id]", options_from_collection_for_select(issue.new_statuses_allowed_to(User.current), :id, :name, issue.status_id), id: "rubylode_progress_issue_status_id" %>
      </p>
    <% end %>
    <% if issue.safe_attribute?("fixed_version_id") %>
      <p>
        <%= label_tag "rubylode_progress_issue_fixed_version_id", l(:field_fixed_version) %>
        <%= select_tag "issue[fixed_version_id]", options_from_collection_for_select(issue.assignable_versions, :id, :name, issue.fixed_version_id), id: "rubylode_progress_issue_fixed_version_id" %>
      </p>
    <% end %>
    <% if issue.safe_attribute?("assigned_to_id") %>
      <p>
        <%= label_tag "rubylode_progress_issue_assigned_to_id", l(:field_assigned_to) %>
        <%= select_tag "issue[assigned_to_id]", content_tag(:option, "", value: "") + options_from_collection_for_select(issue.assignable_users, :id, :name, issue.assigned_to_id), id: "rubylode_progress_issue_assigned_to_id" %>
      </p>
    <% end %>
    <% if issue.safe_attribute?("done_ratio") %>
      <p>
        <%= label_tag "rubylode_progress_issue_done_ratio", l(:field_done_ratio) %>
        <%= select_tag "issue[done_ratio]", options_for_select((0..10).map { |step| ["#{step * 10} %", step * 10] }, issue.done_ratio), id: "rubylode_progress_issue_done_ratio" %>
      </p>
    <% end %>
    <% if issue.safe_attribute?("notes") %>
      <p>
        <%= label_tag "rubylode_progress_issue_notes", l(:field_notes) %>
        <%= text_area_tag "issue[notes]", nil, rows: 5, id: "rubylode_progress_issue_notes" %>
      </p>
    <% end %>
  </div>
  <p class="buttons">
    <%= submit_tag l(:button_save), name: nil %>
    <%= link_to l("rubylode_progress.quick_edit.full_edit"), edit_issue_path(issue, back_url: back_url) %>
    <% if modal %>
      <%= link_to_function l(:button_cancel), "hideModal(this);" %>
    <% else %>
      <%= link_to l(:button_cancel), back_url %>
    <% end %>
  </p>
<% end %>
