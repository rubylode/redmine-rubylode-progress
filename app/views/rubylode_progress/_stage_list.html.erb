<section class="rubylode-progress-stage-list">
  <ol class="rubylode-progress-stages">
    <% progress.stages.each_with_index do |stage, index| %>
      <%= render "stage", stage: stage, project: project, settings: progress.settings,
                          editable_issue_ids: progress.editable_issue_ids,
                          new_issue_mode: progress.new_issue_mode_for(stage.version),
                          rail_style: rubylode_progress_rail_style(progress.stages, index) %>
    <% end %>
  </ol>
</section>
