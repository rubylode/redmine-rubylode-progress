<% current_stage = progress.current_stage %>
<% closed_count = progress.items.count { |item| item.status == :done } %>
<section class="rubylode-progress-tracker">
  <div class="rubylode-progress-tracker__main">
    <p class="rubylode-progress-tracker__position">
      <% if current_stage %>
        <%= l("rubylode_progress.stage_position", number: current_stage.number, total: progress.stages.size) %>
      <% else %>
        <%= l("rubylode_progress.all_stages_done", total: progress.stages.size) %>
      <% end %>
    </p>
    <% if current_stage %>
      <h3 class="rubylode-progress-tracker__headline"><%= current_stage.version.name %></h3>
      <% if current_stage.version.description.present? %>
        <p class="rubylode-progress-tracker__description"><%= current_stage.version.description %></p>
      <% end %>
    <% end %>
    <%= render "track", stages: progress.stages, percent: progress.percent, labels: true, today: today, fold: progress.finished_stage_fold %>
  </div>

  <div class="rubylode-progress-tracker__summary">
    <div class="rubylode-progress-tracker__figure">
      <p class="rubylode-progress-tracker__percent"><%= progress.percent %>%</p>
      <div class="rubylode-progress-tracker__figure-notes">
        <p class="rubylode-progress-tracker__percent-note"><%= l("rubylode_progress.percent_note") %></p>
        <% if last_change_on %>
          <p class="rubylode-progress-tracker__updated"><%= l("rubylode_progress.updated", date: rubylode_progress_updated_text(last_change_on, today)) %></p>
        <% end %>
      </div>
    </div>
    <p class="rubylode-progress-tracker__closed"><%= l("rubylode_progress.closed_of_total", closed: closed_count, total: progress.items.size) %></p>
    <% notices = RubylodeProgress::StageNotices.for(progress.stages, today: today) %>
    <% if notices.any? %>
      <ul class="rubylode-progress-notices">
        <% notices.each do |notice| %>
          <li class="rubylode-progress-notice rubylode-progress-notice--<%= notice.kind.to_s.dasherize %>">
            <span class="rubylode-progress-notice__icon" aria-hidden="true"></span>
            <%= rubylode_progress_notice_text(notice) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
