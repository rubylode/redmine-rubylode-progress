<% current_stage = progress.current_stage %>
<section class="rubylode-progress-tracker">
  <p class="rubylode-progress-tracker__position">
    <% if current_stage %>
      <%= l("rubylode_progress.stage_position", number: current_stage.number, total: progress.stages.size) %>
    <% else %>
      <%= l("rubylode_progress.all_stages_done", total: progress.stages.size) %>
    <% end %>
  </p>
  <% if current_stage %>
    <h3 class="rubylode-progress-tracker__headline"><%= current_stage.version.name %></h3>
    <% if current_stage.version.description.present? %>
      <p class="rubylode-progress-tracker__description"><%= current_stage.version.description %></p>
    <% end %>
  <% end %>

  <div class="rubylode-progress-tracker__bar">
    <%= render "track", stages: progress.stages, percent: progress.percent, labels: true %>
    <span class="rubylode-progress-tracker__percent"><%= progress.percent %>%</span>
  </div>

  <ol class="rubylode-progress-stages">
    <% progress.stages.each do |stage| %>
      <%= render "stage", stage: stage, project: @project, settings: progress.settings,
                          editable_issue_ids: progress.editable_issue_ids,
                          new_issue_mode: progress.new_issue_mode_for(stage.version) %>
    <% end %>
  </ol>
</section>
