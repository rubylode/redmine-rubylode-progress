<% issue = item.issue %>
<% mark_state = rubylode_progress_row_mark_state(item, settings) %>
<% assignee_name = rubylode_progress_assignee_name(issue) %>
<% date_kind, date_text = rubylode_progress_row_date(item, today) %>
<%# Draggable only where the viewer may edit the issue and the checklist is grouped by version (its sections are the drop targets). %>
<% movable = grouping == "version" && editable_issue_ids.include?(issue.id) %>
<li class="<%= (["rubylode-progress-row"] + [mark_state.to_s, item.status.to_s.dasherize].uniq.map { |state| "rubylode-progress-row--#{state}" }).join(" ") %>" id="rubylode-progress-item-<%= issue.id %>"
    <%= tag.attributes(draggable: "true", data: { issue_id: issue.id, current_version_id: issue.fixed_version_id, update_path: issue_path(issue) }) if movable %>>
  <span class="rubylode-progress-row__mark rubylode-progress-row__mark--<%= mark_state %>" aria-hidden="true"></span>
  <div class="rubylode-progress-row__main">
    <span class="rubylode-progress-row__title"><%= render "item_title_link", project: project, issue: issue %></span>
    <% if note.present? %>
      <% note_preview, note_is_long = rubylode_progress_note_preview(note) %>
      <p class="rubylode-progress-row__note"><%= note_preview %></p>
      <% if note_is_long %>
        <details class="rubylode-progress-row__note-more">
          <summary><%= l("rubylode_progress.checklist.show_note") %></summary>
          <p class="rubylode-progress-row__note-full"><%= note %></p>
        </details>
      <% end %>
    <% end %>
  </div>
  <%# Open on a wide screen; the controller folds it on a phone, where the button opens it again. %>
  <details class="rubylode-progress-more" open>
    <summary class="rubylode-progress-more__button" aria-label="<%= l("rubylode_progress.row_more", number: issue.id) %>"><span aria-hidden="true">&hellip;</span></summary>
    <span class="rubylode-progress-hover-actions rubylode-progress-more__links">
      <% if editable_issue_ids.include?(issue.id) %>
        <%= render "quick_edit_link", project: project, issue: issue, filter: filter %>
      <% end %>
      <%= render "new_tab_link", issue: issue %>
    </span>
  </details>
  <%= link_to "##{issue.id}", issue_path(issue), class: "rubylode-progress-row__number" %>
  <% if assignee_name %><span class="rubylode-progress-row__assignee"><%= assignee_name %></span><% end %>
  <span class="rubylode-progress-pill rubylode-progress-pill--<%= item.status.to_s.dasherize %>"><%= rubylode_progress_status_label(item.status) %></span>
  <span class="rubylode-progress-row__date rubylode-progress-row__date--<%= date_kind %>"><%= date_text %></span>
</li>
