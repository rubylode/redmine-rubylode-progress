# Copy to .env (git-ignored) and fill in with secret references, never values.
# Access token for the Git host the release is pushed through (write:repository, read:user, write:user).
GITEA_TOKEN=
# GitHub token the publish job pushes with (contents and workflows write on the public repository). It is stored on the
# Gitea repository as the Actions secret PUBLISH_GITHUB_TOKEN; this copy is only for setting or rotating that secret.
RUBYLODE_GITHUB_PUBLISH_TOKEN=
